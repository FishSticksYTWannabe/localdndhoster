{
  "name": "localdndhoster",
  "version": "0.1.0",
  "private": true,
  "description": "Local D&D hoster with DM host and player client desktop app",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "vite build",
    "preview": "vite preview",
    "start": "electron .",
    "package": "electron-builder"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
    ,"three": "^0.171.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.3",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^10.0.4",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "wait-on": "^7.0.1",
    "vite": "^8.2.0",
    "typescript": "^7.0.2",
    "ws": "^8.14.1"
    ,"@types/three": "^0.171.0"
  },
  "build": {
    "appId": "com.localdndhoster.app",
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "directories": {
      "buildResources": "build"
    }
  }
}
